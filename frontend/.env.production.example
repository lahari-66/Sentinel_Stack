# Copy to .env.production.local (git-ignored) before running deploy/deploy.ps1 or deploy/deploy.sh.
# Values come from docs/setup/week1-track-c-aws-steps.md. All are public identifiers, not secrets.
NEXT_PUBLIC_COGNITO_DOMAIN=https://<your-domain-prefix>.auth.ap-south-1.amazoncognito.com
NEXT_PUBLIC_COGNITO_CLIENT_ID=<app client id>
NEXT_PUBLIC_COGNITO_REDIRECT_URI=https://<distribution>.cloudfront.net/auth/callback/
NEXT_PUBLIC_COGNITO_LOGOUT_URI=https://<distribution>.cloudfront.net/login/
# Leave empty until Track B's API is live - the site then uses demo data.
NEXT_PUBLIC_API_URL=
