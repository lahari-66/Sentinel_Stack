# Copy to .env.local. Leave everything empty to run in demo mode on mock data.
# All values are public (they ship to the browser) — never put secrets here.

# API Gateway HTTP API base URL, e.g. https://abc123.execute-api.ap-south-1.amazonaws.com
NEXT_PUBLIC_API_URL=

# Cognito hosted UI, e.g. https://sentinelstack-dev.auth.ap-south-1.amazoncognito.com
NEXT_PUBLIC_COGNITO_DOMAIN=
# App client ID (public client, no secret, authorization-code grant with PKCE)
NEXT_PUBLIC_COGNITO_CLIENT_ID=
# Must exactly match a callback / sign-out URL configured on the app client
NEXT_PUBLIC_COGNITO_REDIRECT_URI=http://localhost:3000/auth/callback/
NEXT_PUBLIC_COGNITO_LOGOUT_URI=http://localhost:3000/login/

# Force mock data even when an API URL is set (true/false)
NEXT_PUBLIC_USE_MOCKS=
